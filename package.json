{
  "name": "typescript-solutions-template",
  "version": "0.0.0",
  "description": "A template for solving programming problems in TypeScript",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "new": "node scripts/create-problem.js",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt --check \"src/**/*.ts\"",
    "format:fix": "oxfmt --write \"src/**/*.ts\"",
    "dev": "tsx",
    "dev:watch": "tsx --watch",
    "typecheck": "tsc --noEmit",
    "release": "commit-and-tag-version"
  },
  "keywords": [
    "typescript",
    "algorithms",
    "coding-problems",
    "leetcode",
    "vitest"
  ],
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "commit-and-tag-version": "^13.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}